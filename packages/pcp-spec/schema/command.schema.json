{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-frame.dev/pcp/schema/command.schema.json",
  "title": "PcpCommand",
  "type": "object",
  "required": ["protocol", "kind", "id", "ts", "commandId", "type", "payload"],
  "properties": {
    "protocol": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "command" },
    "id": { "type": "string" },
    "ts": { "type": "integer" },
    "commandId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string" },
    "type": {
      "type": "string",
      "enum": [
        "pi.packages.list",
        "pi.packages.update",
        "pi.packages.remove",
        "pi.packages.pin",
        "daemon.getStatus",
        "daemon.getConfig",
        "daemon.setConfig",
        "session.list",
        "session.create",
        "session.open",
        "session.attach",
        "session.detach",
        "session.closeWorker",
        "session.rename",
        "session.fork",
        "session.clone",
        "session.getTree",
        "session.getEntries",
        "session.getStats",
        "session.getForkPoints",
        "agent.prompt",
        "agent.steer",
        "agent.followUp",
        "agent.abort",
        "agent.clearQueue",
        "agent.interrupt",
        "agent.compact",
        "agent.setContextWindowOverride",
        "agent.setCompactionReservePercent",
        "agent.setAutoCompaction",
        "agent.setAutoRetry",
        "agent.abortRetry",
        "agent.setModel",
        "agent.getModels",
        "agent.setThinkingLevel",
        "agent.getThinkingLevels",
        "agent.setSteeringMode",
        "agent.setFollowUpMode",
        "agent.getCommands",
        "ui.claim",
        "ui.respond",
        "workspace.refresh",
        "workspace.getDiff",
        "workspace.listFiles",
        "workspace.readFile",
        "workspace.saveFile",
        "workspace.gitAction",
        "remote.getStatus",
        "remote.start",
        "remote.stop",
        "remote.generatePairing",
        "remote.setDeviceMode",
        "remote.installCloudflared",
        "remote.installTailscale",
        "remote.setTailscaleHostname",
        "remote.revokeDevice",
        "remote.revokeAll",
        "remote.setOptions"
      ]
    },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "pi.packages.list" } }, "required": ["type"] },
      "then": { "properties": { "payload": { "type": "object", "additionalProperties": false } } }
    },
    {
      "if": { "properties": { "type": { "enum": ["pi.packages.update", "pi.packages.remove"] } }, "required": ["type"] },
      "then": { "properties": { "payload": { "type": "object", "required": ["source"], "properties": { "source": { "type": "string", "minLength": 1, "maxLength": 512 } }, "additionalProperties": false } } }
    },
    {
      "if": { "properties": { "type": { "const": "pi.packages.pin" } }, "required": ["type"] },
      "then": { "properties": { "payload": { "type": "object", "required": ["source", "version"], "properties": { "source": { "type": "string", "minLength": 1, "maxLength": 512 }, "version": { "type": "string", "minLength": 1, "maxLength": 128 } }, "additionalProperties": false } } }
    },
    {
      "if": { "properties": { "type": { "const": "workspace.listFiles" } }, "required": ["type"] },
      "then": { "properties": { "payload": { "type": "object", "additionalProperties": false } } }
    },
    {
      "if": { "properties": { "type": { "const": "workspace.readFile" } }, "required": ["type"] },
      "then": { "properties": { "payload": { "type": "object", "required": ["path"], "properties": { "path": { "type": "string", "minLength": 1 } }, "additionalProperties": false } } }
    },
    {
      "if": { "properties": { "type": { "const": "workspace.saveFile" } }, "required": ["type"] },
      "then": { "properties": { "payload": { "type": "object", "required": ["path", "content", "revision"], "properties": { "path": { "type": "string", "minLength": 1 }, "content": { "type": "string", "maxLength": 1048576 }, "revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "additionalProperties": false } } }
    },
    {
      "if": { "properties": { "type": { "const": "workspace.gitAction" } }, "required": ["type"] },
      "then": { "properties": { "payload": { "type": "object", "required": ["action", "paths"], "properties": { "action": { "enum": ["stage", "unstage", "commit", "discard"] }, "paths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "expectedStagedPaths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "message": { "type": "string", "minLength": 1 } }, "additionalProperties": false } } }
    }
  ]
}
