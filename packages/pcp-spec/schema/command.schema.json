{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-crust.dev/pcp/schema/command.schema.json",
  "title": "PcpCommand",
  "type": "object",
  "required": ["protocol", "kind", "id", "ts", "commandId", "type", "payload"],
  "properties": {
    "protocol": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "command" },
    "id": { "type": "string" },
    "ts": { "type": "integer" },
    "commandId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string" },
    "type": {
      "type": "string",
      "enum": [
        "daemon.getStatus",
        "daemon.getConfig",
        "daemon.setConfig",
        "session.list",
        "session.create",
        "session.open",
        "session.attach",
        "session.detach",
        "session.closeWorker",
        "session.rename",
        "session.fork",
        "session.clone",
        "session.getTree",
        "session.getEntries",
        "session.getStats",
        "session.getForkPoints",
        "agent.prompt",
        "agent.steer",
        "agent.followUp",
        "agent.abort",
        "agent.clearQueue",
        "agent.interrupt",
        "agent.compact",
        "agent.setAutoCompaction",
        "agent.setAutoRetry",
        "agent.abortRetry",
        "agent.setModel",
        "agent.getModels",
        "agent.setThinkingLevel",
        "agent.getThinkingLevels",
        "agent.setSteeringMode",
        "agent.setFollowUpMode",
        "agent.getCommands",
        "ui.claim",
        "ui.respond",
        "workspace.refresh",
        "workspace.getDiff"
      ]
    },
    "payload": { "type": "object" }
  }
}
