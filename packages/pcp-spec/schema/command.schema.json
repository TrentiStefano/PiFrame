{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-frame.dev/pcp/schema/command.schema.json",
  "title": "PcpCommand",
  "type": "object",
  "required": ["protocol", "kind", "id", "ts", "commandId", "type", "payload"],
  "properties": {
    "protocol": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "command" },
    "id": { "type": "string" },
    "ts": { "type": "integer" },
    "commandId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string" },
    "type": {
      "type": "string",
      "enum": [
        "pi.packages.list",
        "pi.packages.update",
        "pi.packages.remove",
        "pi.packages.pin",
        "pi.agents.get",
        "pi.agents.update",
        "daemon.getStatus",
        "daemon.getConfig",
        "daemon.setConfig",
        "session.list",
        "session.create",
        "session.open",
        "session.attach",
        "session.detach",
        "session.closeWorker",
        "session.rename",
        "session.fork",
        "session.clone",
        "session.getTree",
        "session.getEntries",
        "session.getStats",
        "session.getForkPoints",
        "agent.prompt",
        "agent.steer",
        "agent.followUp",
        "agent.abort",
        "agent.clearQueue",
        "agent.interrupt",
        "agent.compact",
        "agent.setContextWindowOverride",
        "agent.setCompactionReservePercent",
        "agent.setAutoCompaction",
        "agent.setAutoRetry",
        "agent.abortRetry",
        "agent.setModel",
        "agent.authLogin",
        "agent.authLogout",
        "agent.getModels",
        "agent.setThinkingLevel",
        "agent.getThinkingLevels",
        "agent.setSteeringMode",
        "agent.setFollowUpMode",
        "agent.getCommands",
        "ui.claim",
        "ui.respond",
        "workspace.refresh",
        "workspace.getDiff",
        "workspace.listFiles",
        "workspace.readFile",
        "workspace.saveFile",
        "workspace.gitAction",
        "workspace.listBranches",
        "workspace.switchBranch",
        "remote.getStatus",
        "remote.start",
        "remote.stop",
        "remote.generatePairing",
        "remote.setDeviceMode",
        "remote.installCloudflared",
        "remote.installTailscale",
        "remote.setTailscaleHostname",
        "remote.revokeDevice",
        "remote.revokeAll",
        "remote.setOptions",
        "system.metrics.subscribe",
        "system.metrics.unsubscribe",
        "side.open",
        "side.prompt",
        "side.abort",
        "side.close"
      ]
    },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "pi.packages.list" } }, "required": ["type"] },
      "then": { "properties": { "payload": { "type": "object", "additionalProperties": false } } }
    },
    {
      "if": { "properties": { "type": { "enum": ["pi.packages.update", "pi.packages.remove"] } }, "required": ["type"] },
      "then": { "properties": { "payload": { "type": "object", "required": ["source"], "properties": { "source": { "type": "string", "minLength": 1, "maxLength": 512 } }, "additionalProperties": false } } }
    },
    {
      "if": { "properties": { "type": { "const": "pi.packages.pin" } }, "required": ["type"] },
      "then": { "properties": { "payload": { "type": "object", "required": ["source", "version"], "properties": { "source": { "type": "string", "minLength": 1, "maxLength": 512 }, "version": { "type": "string", "minLength": 1, "maxLength": 128 } }, "additionalProperties": false } } }
    },
    {
      "if": { "properties": { "type": { "const": "pi.agents.get" } }, "required": ["type"] },
      "then": { "properties": { "payload": { "type": "object", "properties": { "cwd": { "type": "string" } }, "additionalProperties": false } } }
    },
    {
      "if": { "properties": { "type": { "const": "pi.agents.update" } }, "required": ["type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["changes"],
            "properties": {
              "changes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["kind"],
                  "properties": {
                    "kind": { "type": "string", "enum": ["agent", "subagentDefaults", "sessionDefaults"] }
                  },
                  "allOf": [
                    {
                      "if": { "properties": { "kind": { "const": "agent" } }, "required": ["kind"] },
                      "then": {
                        "required": ["name"],
                        "properties": {
                          "kind": { "type": "string" },
                          "name": { "type": "string", "minLength": 1 },
                          "model": { "type": ["string", "null"] },
                          "thinking": { "type": ["string", "null"] },
                          "contextLimit": { "type": ["integer", "null"] }
                        },
                        "additionalProperties": false
                      }
                    },
                    {
                      "if": { "properties": { "kind": { "const": "subagentDefaults" } }, "required": ["kind"] },
                      "then": {
                        "properties": {
                          "kind": { "type": "string" },
                          "model": { "type": ["string", "null"] },
                          "thinking": { "type": ["string", "null"] },
                          "fallbackAgent": { "type": ["string", "null"] }
                        },
                        "additionalProperties": false
                      }
                    },
                    {
                      "if": { "properties": { "kind": { "const": "sessionDefaults" } }, "required": ["kind"] },
                      "then": {
                        "properties": {
                          "kind": { "type": "string" },
                          "model": { "type": ["string", "null"] },
                          "thinking": { "type": ["string", "null"] }
                        },
                        "additionalProperties": false
                      }
                    }
                  ]
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "enum": ["agent.authLogin", "agent.authLogout"] } }, "required": ["type"] },
      "then": { "properties": { "payload": { "type": "object", "additionalProperties": false } } }
    },
    {
      "if": { "properties": { "type": { "const": "workspace.listFiles" } }, "required": ["type"] },
      "then": { "properties": { "payload": { "type": "object", "additionalProperties": false } } }
    },
    {
      "if": { "properties": { "type": { "const": "workspace.readFile" } }, "required": ["type"] },
      "then": { "properties": { "payload": { "type": "object", "required": ["path"], "properties": { "path": { "type": "string", "minLength": 1 } }, "additionalProperties": false } } }
    },
    {
      "if": { "properties": { "type": { "const": "workspace.saveFile" } }, "required": ["type"] },
      "then": { "properties": { "payload": { "type": "object", "required": ["path", "content", "revision"], "properties": { "path": { "type": "string", "minLength": 1 }, "content": { "type": "string", "maxLength": 1048576 }, "revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "additionalProperties": false } } }
    },
    {
      "if": { "properties": { "type": { "const": "workspace.gitAction" } }, "required": ["type"] },
      "then": { "properties": { "payload": { "type": "object", "required": ["action", "paths"], "properties": { "action": { "enum": ["stage", "unstage", "commit", "discard"] }, "paths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "expectedStagedPaths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "message": { "type": "string", "minLength": 1 } }, "additionalProperties": false } } }
    },
    {
      "if": { "properties": { "type": { "const": "workspace.listBranches" } }, "required": ["type"] },
      "then": { "properties": { "payload": { "type": "object", "additionalProperties": false } } }
    },
    {
      "if": { "properties": { "type": { "const": "workspace.switchBranch" } }, "required": ["type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["branch"],
            "properties": {
              "branch": { "type": "string", "minLength": 1, "maxLength": 255 },
              "onDirty": { "type": "string", "enum": ["block", "stash"] }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "enum": ["system.metrics.subscribe", "system.metrics.unsubscribe"] } }, "required": ["type"] },
      "then": { "properties": { "payload": { "type": "object", "additionalProperties": false } } }
    },
    {
      "if": { "properties": { "type": { "const": "side.open" } }, "required": ["type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["sessionId"],
            "properties": {
              "sessionId": { "type": "string", "minLength": 1 },
              "question": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "side.prompt" } }, "required": ["type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["sideId", "text"],
            "properties": {
              "sideId": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "enum": ["side.abort", "side.close"] } }, "required": ["type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["sideId"],
            "properties": {
              "sideId": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
