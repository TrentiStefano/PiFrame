{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-frame.dev/pcp/schema/event.schema.json",
  "title": "PcpEvent",
  "type": "object",
  "required": ["protocol", "kind", "id", "ts", "sessionId", "seq", "type", "payload"],
  "properties": {
    "protocol": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "event" },
    "id": { "type": "string" },
    "ts": { "type": "integer" },
    "sessionId": { "type": "string" },
    "seq": { "type": "integer", "minimum": 0 },
    "type": {
      "type": "string",
      "enum": [
        "session.status",
        "run.started",
        "run.ended",
        "run.settled",
        "turn.started",
        "turn.ended",
        "message.started",
        "message.completed",
        "text.started",
        "text.delta",
        "text.completed",
        "thinking.started",
        "thinking.delta",
        "thinking.completed",
        "toolcall.started",
        "toolcall.argsDelta",
        "toolcall.completed",
        "usage.updated",
        "tool.started",
        "tool.progress",
        "tool.completed",
        "queue.changed",
        "compaction.started",
        "compaction.ended",
        "retry.started",
        "retry.ended",
        "summarization.retry",
        "bash.output",
        "extension.error",
        "ui.request",
        "ui.claimed",
        "ui.resolved",
        "ui.notify",
        "ui.status",
        "ui.widget",
        "ui.editorText",
        "ui.title",
        "workspace.changed",
        "worker.diagnostic",
        "worker.crashed",
        "journal.gap",
        "session.indexChanged",
        "daemon.configChanged",
        "remote.statusChanged"
      ]
    },
    "payload": { "type": "object" }
  }
}
