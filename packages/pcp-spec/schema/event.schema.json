{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-frame.dev/pcp/schema/event.schema.json",
  "title": "PcpEvent",
  "type": "object",
  "required": ["protocol", "kind", "id", "ts", "sessionId", "seq", "type", "payload"],
  "properties": {
    "protocol": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "event" },
    "id": { "type": "string" },
    "ts": { "type": "integer" },
    "sessionId": { "type": "string" },
    "seq": { "type": "integer", "minimum": 0 },
    "type": {
      "type": "string",
      "enum": [
        "session.status",
        "run.started",
        "run.ended",
        "run.settled",
        "turn.started",
        "turn.ended",
        "message.started",
        "message.completed",
        "text.started",
        "text.delta",
        "text.completed",
        "thinking.started",
        "thinking.delta",
        "thinking.completed",
        "toolcall.started",
        "toolcall.argsDelta",
        "toolcall.completed",
        "usage.updated",
        "tool.started",
        "tool.progress",
        "tool.completed",
        "queue.changed",
        "compaction.started",
        "compaction.ended",
        "retry.started",
        "retry.ended",
        "summarization.retry",
        "bash.output",
        "extension.error",
        "ui.request",
        "ui.claimed",
        "ui.resolved",
        "ui.notify",
        "ui.status",
        "ui.widget",
        "ui.editorText",
        "ui.title",
        "workspace.changed",
        "worker.diagnostic",
        "worker.crashed",
        "journal.gap",
        "session.indexChanged",
        "daemon.configChanged",
        "remote.statusChanged",
        "system.metrics",
        "side.opened",
        "side.closed"
      ]
    },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "system.metrics" } }, "required": ["type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["sampledAt", "cpu", "memory", "disk", "gpu"],
            "additionalProperties": false,
            "properties": {
              "sampledAt": { "type": "integer" },
              "cpu": {
                "type": ["object", "null"],
                "required": ["percent"],
                "additionalProperties": false,
                "properties": {
                  "percent": { "type": "number", "minimum": 0, "maximum": 100 }
                }
              },
              "memory": {
                "type": ["object", "null"],
                "required": ["usedBytes", "totalBytes", "percent"],
                "additionalProperties": false,
                "properties": {
                  "usedBytes": { "type": "number", "minimum": 0 },
                  "totalBytes": { "type": "number", "minimum": 0 },
                  "percent": { "type": "number", "minimum": 0, "maximum": 100 }
                }
              },
              "disk": {
                "type": ["object", "null"],
                "required": ["usedBytes", "totalBytes", "percent"],
                "additionalProperties": false,
                "properties": {
                  "usedBytes": { "type": "number", "minimum": 0 },
                  "totalBytes": { "type": "number", "minimum": 0 },
                  "percent": { "type": "number", "minimum": 0, "maximum": 100 }
                }
              },
              "gpu": {
                "type": "object",
                "required": ["percent", "memoryUsedBytes", "memoryTotalBytes", "source"],
                "additionalProperties": false,
                "properties": {
                  "percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
                  "memoryUsedBytes": { "type": ["number", "null"], "minimum": 0 },
                  "memoryTotalBytes": { "type": ["number", "null"], "minimum": 0 },
                  "source": { "type": ["string", "null"], "enum": ["nvidia-smi", "typeperf", "sysfs", "ioreg", null] }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "side.opened" } }, "required": ["type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["sideId", "parentSessionId", "model"],
            "properties": {
              "sideId": { "type": "string", "minLength": 1 },
              "parentSessionId": { "type": "string", "minLength": 1 },
              "model": {}
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "side.closed" } }, "required": ["type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["sideId", "reason"],
            "properties": {
              "sideId": { "type": "string", "minLength": 1 },
              "reason": {
                "type": "string",
                "enum": ["user", "idle", "parentClosed", "error", "shutdown"]
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
