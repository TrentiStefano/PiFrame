{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-frame.dev/pcp/schema/error.schema.json",
  "title": "PcpError",
  "type": "object",
  "required": ["protocol", "kind", "id", "ts", "type", "payload"],
  "properties": {
    "protocol": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "error" },
    "id": { "type": "string" },
    "ts": { "type": "integer" },
    "commandId": { "type": "string" },
    "sessionId": { "type": "string" },
    "type": { "type": "string", "const": "error" },
    "payload": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "AUTH_FAILED",
            "PROTOCOL_VERSION_UNSUPPORTED",
            "INVALID_MESSAGE",
            "SESSION_NOT_FOUND",
            "SESSION_BUSY",
            "WORKER_UNAVAILABLE",
            "WORKER_CRASHED",
            "PI_NOT_FOUND",
            "PI_VERSION_UNSUPPORTED",
            "COMMAND_REJECTED",
            "COMMAND_TIMEOUT",
            "UI_REQUEST_NOT_CLAIMED",
            "UI_REQUEST_EXPIRED",
            "JOURNAL_GAP",
            "CONFIG_INVALID",
            "RATE_LIMITED",
            "INTERNAL",
            "REMOTE_FORBIDDEN",
            "BRANCH_INVALID_NAME",
            "BRANCH_NOT_FOUND",
            "WORKSPACE_DIRTY",
            "BRANCH_SWITCH_FAILED",
            "AGENTS_VALIDATION_FAILED",
            "AGENTS_CONFIG_UNREADABLE",
            "AGENTS_CONFIG_LOCKED",
            "AGENTS_PACKAGE_NOT_INSTALLED",
            "GIT_FAILED",
            "INVALID_JSON",
            "INVALID_MODEL_CATALOG",
            "LISTENER_NOT_INITIALIZED",
            "MODEL_CATALOG_FAILED",
            "NO_CREDENTIALS",
            "PACKAGE_UPDATE_UNSUPPORTED_PLATFORM",
            "PAIRING_EXPIRED",
            "PAIRING_INVALID",
            "PAYLOAD_TOO_LARGE",
            "PI_EXECUTION_FAILED",
            "PI_VERSION_UNPARSEABLE",
            "REMOTE_DEVICE_LIMIT",
            "REMOTE_NOT_ACTIVE",
            "RESPONSE_TOO_LARGE",
            "SESSION_DIRECTORY_READ_FAILED",
            "SIDE_LIMIT_REACHED",
            "SIDE_NOT_FOUND",
            "SIDE_RPC_BLOCKED",
            "SIDE_STREAM_READ_ONLY",
            "SIDE_UNSAFE_TOOLS",
            "TOKEN_REFRESH_FAILED",
            "UNTRUSTED_ENDPOINT",
            "WORKSPACE_COMMIT_MESSAGE_REQUIRED",
            "WORKSPACE_FILE_NOT_FOUND",
            "WORKSPACE_FILE_TOO_LARGE",
            "WORKSPACE_GIT_ACTION_INVALID",
            "WORKSPACE_INVALID",
            "WORKSPACE_INVALID_CONTENT",
            "WORKSPACE_NOT_FOUND",
            "WORKSPACE_NOT_REPOSITORY",
            "WORKSPACE_PATH_INVALID",
            "WORKSPACE_REVISION_CONFLICT",
            "WORKSPACE_REVISION_REQUIRED",
            "WORKSPACE_STAGED_SET_MISMATCH",
            "WORKSPACE_STALE_STATUS",
            "WORKSPACE_UNSUPPORTED_FILE"
          ]
        },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "details": {
          "anyOf": [
            { "type": "object" },
            { "type": "array" }
          ]
        },
        "hint": { "type": "string" }
      }
    }
  }
}
