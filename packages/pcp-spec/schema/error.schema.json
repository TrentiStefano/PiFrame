{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-frame.dev/pcp/schema/error.schema.json",
  "title": "PcpError",
  "type": "object",
  "required": ["protocol", "kind", "id", "ts", "type", "payload"],
  "properties": {
    "protocol": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "error" },
    "id": { "type": "string" },
    "ts": { "type": "integer" },
    "commandId": { "type": "string" },
    "sessionId": { "type": "string" },
    "type": { "type": "string", "const": "error" },
    "payload": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "AUTH_FAILED",
            "PROTOCOL_VERSION_UNSUPPORTED",
            "INVALID_MESSAGE",
            "SESSION_NOT_FOUND",
            "SESSION_BUSY",
            "WORKER_UNAVAILABLE",
            "WORKER_CRASHED",
            "PI_NOT_FOUND",
            "PI_VERSION_UNSUPPORTED",
            "COMMAND_REJECTED",
            "COMMAND_TIMEOUT",
            "UI_REQUEST_NOT_CLAIMED",
            "UI_REQUEST_EXPIRED",
            "JOURNAL_GAP",
            "CONFIG_INVALID",
            "RATE_LIMITED",
            "INTERNAL",
            "REMOTE_FORBIDDEN",
            "BRANCH_INVALID_NAME",
            "BRANCH_NOT_FOUND",
            "WORKSPACE_DIRTY",
            "BRANCH_SWITCH_FAILED",
            "AGENTS_VALIDATION_FAILED",
            "AGENTS_CONFIG_UNREADABLE",
            "AGENTS_CONFIG_LOCKED",
            "AGENTS_PACKAGE_NOT_INSTALLED"
          ]
        },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "details": {
          "anyOf": [
            { "type": "object" },
            { "type": "array" }
          ]
        },
        "hint": { "type": "string" }
      }
    }
  }
}
