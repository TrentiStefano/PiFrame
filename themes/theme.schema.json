{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-crust.dev/theme.schema.json",
  "title": "Pi-Crust Theme Schema",
  "description": "Schema definition for Pi-Crust themes version 1",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "variant"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-_]+$" },
    "name": { "type": "string" },
    "author": { "type": "string" },
    "version": { "type": "string" },
    "variant": { "type": "string", "enum": ["dark", "light"] },
    "extends": { "type": ["string", "null"] },
    "colors": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9]+$": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" }
      },
      "properties": {
        "background": { "type": "string" },
        "surface": { "type": "string" },
        "surfaceElevated": { "type": "string" },
        "overlay": { "type": "string" },
        "border": { "type": "string" },
        "borderStrong": { "type": "string" },
        "textPrimary": { "type": "string" },
        "textSecondary": { "type": "string" },
        "textMuted": { "type": "string" },
        "accent": { "type": "string" },
        "accentContrast": { "type": "string" },
        "focusRing": { "type": "string" },
        "success": { "type": "string" },
        "warning": { "type": "string" },
        "danger": { "type": "string" },
        "info": { "type": "string" },
        "agentWorking": { "type": "string" },
        "agentRetrying": { "type": "string" },
        "agentCompacting": { "type": "string" },
        "agentSettled": { "type": "string" },
        "agentAwaitingUser": { "type": "string" },
        "agentError": { "type": "string" },
        "userBubble": { "type": "string" },
        "thinking": { "type": "string" },
        "diffAddedBg": { "type": "string" },
        "diffAddedFg": { "type": "string" },
        "diffRemovedBg": { "type": "string" },
        "diffRemovedFg": { "type": "string" },
        "diffContextFg": { "type": "string" }
      }
    },
    "syntax": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9]+$": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" }
      },
      "properties": {
        "keyword": { "type": "string" },
        "string": { "type": "string" },
        "number": { "type": "string" },
        "comment": { "type": "string" },
        "function": { "type": "string" },
        "type": { "type": "string" },
        "variable": { "type": "string" },
        "operator": { "type": "string" },
        "punctuation": { "type": "string" },
        "invalid": { "type": "string" }
      }
    },
    "typography": {
      "type": "object",
      "properties": {
        "uiFontFamily": { "type": "string" },
        "monoFontFamily": { "type": "string" },
        "baseSize": { "type": "number" },
        "scale": {
          "type": "object",
          "properties": {
            "xs": { "type": "number" },
            "sm": { "type": "number" },
            "md": { "type": "number" },
            "lg": { "type": "number" },
            "xl": { "type": "number" },
            "xxl": { "type": "number" }
          }
        },
        "lineHeight": { "type": "number" },
        "weights": {
          "type": "object",
          "properties": {
            "regular": { "type": "integer" },
            "medium": { "type": "integer" },
            "semibold": { "type": "integer" }
          }
        }
      }
    },
    "spacing": {
      "type": "object",
      "properties": {
        "unit": { "type": "number" },
        "scale": {
          "type": "array",
          "items": { "type": "number" }
        }
      }
    },
    "radii": {
      "type": "object",
      "properties": {
        "sm": { "type": "number" },
        "md": { "type": "number" },
        "lg": { "type": "number" },
        "pill": { "type": "number" }
      }
    },
    "elevation": {
      "type": "object",
      "properties": {
        "level1": {
          "type": "object",
          "properties": {
            "color": { "type": "string" },
            "blur": { "type": "number" },
            "offsetY": { "type": "number" }
          }
        },
        "level2": {
          "type": "object",
          "properties": {
            "color": { "type": "string" },
            "blur": { "type": "number" },
            "offsetY": { "type": "number" }
          }
        }
      }
    },
    "motion": {
      "type": "object",
      "properties": {
        "fast": { "type": "number" },
        "normal": { "type": "number" },
        "slow": { "type": "number" },
        "curve": { "type": "string" }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
