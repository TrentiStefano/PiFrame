{
  "$schema": "./theme.schema.json",
  "schemaVersion": 1,
  "id": "crust-light",
  "name": "Crust Light",
  "author": "Pi-Crust",
  "version": "1.0.0",
  "variant": "light",
  "extends": null,
  "colors": {
    "background": "#F6F8FA",
    "surface": "#FFFFFF",
    "surfaceElevated": "#F0F3F6",
    "overlay": "#0A0D1233",
    "border": "#D0D7DE",
    "borderStrong": "#8C959F80",
    "textPrimary": "#1F2328",
    "textSecondary": "#57606A",
    "textMuted": "#8C959F",
    "accent": "#0969DA",
    "accentContrast": "#FFFFFF",
    "focusRing": "#0969DA",
    "success": "#1A7F37",
    "warning": "#9A6700",
    "danger": "#CF222E",
    "info": "#0969DA",
    "agentWorking": "#0969DA",
    "agentRetrying": "#9A6700",
    "agentCompacting": "#0969DA",
    "agentSettled": "#1A7F37",
    "agentAwaitingUser": "#8250DF",
    "agentError": "#CF222E",
    "userBubble": "#EAEFF5",
    "thinking": "#6639BA",
    "diffAddedBg": "#E6FFEC",
    "diffAddedFg": "#1A7F37",
    "diffRemovedBg": "#FFEBE9",
    "diffRemovedFg": "#CF222E",
    "diffContextFg": "#57606A"
  },
  "syntax": {
    "keyword": "#CF222E",
    "string": "#0A3069",
    "number": "#953800",
    "comment": "#6E7781",
    "function": "#8250DF",
    "type": "#0550AE",
    "variable": "#1F2328",
    "operator": "#57606A",
    "punctuation": "#57606A",
    "invalid": "#CF222E"
  },
  "typography": {
    "uiFontFamily": "Inter",
    "monoFontFamily": "JetBrains Mono",
    "baseSize": 14,
    "scale": { "xs": 11, "sm": 12, "md": 14, "lg": 16, "xl": 20, "xxl": 26 },
    "lineHeight": 1.5,
    "weights": { "regular": 400, "medium": 500, "semibold": 600 }
  },
  "spacing": { "unit": 4, "scale": [0, 4, 8, 12, 16, 24, 32, 48] },
  "radii": { "sm": 6, "md": 10, "lg": 16, "pill": 999 },
  "elevation": {
    "level1": { "color": "#00000014", "blur": 12, "offsetY": 2 },
    "level2": { "color": "#00000029", "blur": 28, "offsetY": 8 }
  },
  "motion": { "fast": 120, "normal": 180, "slow": 280, "curve": "easeOutCubic" },
  "components": {
    "sidebar": { "background": "#F0F3F6", "width": 280 },
    "composer": { "background": "#FFFFFF", "minHeight": 96 },
    "toolCard": { "background": "#F6F8FA", "borderRadius": 10 }
  }
}
