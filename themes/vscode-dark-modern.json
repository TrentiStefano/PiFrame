{
  "$schema": "./theme.schema.json",
  "schemaVersion": 1,
  "id": "vscode-dark-modern",
  "name": "VS Code Dark Modern",
  "author": "Microsoft (PiFrame adaptation)",
  "version": "1.0.0",
  "variant": "dark",
  "extends": null,
  "colors": {
    "background": "#1F1F1F",
    "chassis": "#181818",
