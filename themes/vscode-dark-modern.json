    "surface": "#181818",
    "surfaceElevated": "#202020",
    "overlay": "#1F1F1FCC",
    "border": "#2B2B2B",
    "borderStrong": "#0078D4",
    "textPrimary": "#CCCCCC",
    "textSecondary": "#9D9D9D",
    "textMuted": "#6E7681",
    "accent": "#0078D4",
    "accentContrast": "#FFFFFF",
    "focusRing": "#0078D4",
    "success": "#2EA043",
    "warning": "#D7BA7D",
    "danger": "#F85149",
    "info": "#4DAAFC",
    "agentWorking": "#4DAAFC",
    "agentRetrying": "#D7BA7D",
    "agentCompacting": "#0078D4",
    "agentSettled": "#2EA043",
    "agentAwaitingUser": "#D7BA7D",
    "agentError": "#F85149",
