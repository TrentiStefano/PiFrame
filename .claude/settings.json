{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(gh *human-approved*)",
      "Bash(gh label create*)",
      "Bash(gh label edit*)",
      "Bash(gh label delete*)",
      "PowerShell(gh *human-approved*)",
      "PowerShell(gh label create*)",
      "PowerShell(gh label edit*)",
      "PowerShell(gh label delete*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-command.mjs"]
          }
        ]
      }
    ]
  }
}
