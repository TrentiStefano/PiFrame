{
  "name": "aborted-turn",
  "description": "Partial assistant text ends with an aborted stop reason.",
  "events": [
    {
      "delayMs": 5,
      "event": {
        "type": "agent_start"
      }
    },
    {
      "delayMs": 5,
      "event": {
        "type": "turn_start"
      }
    },
    {
      "event": {
        "type": "message_start",
        "message": {
          "role": "user",
          "content": "{{prompt}}",
          "timestamp": "{{now}}"
        }
      }
    },
    {
      "event": {
        "type": "message_end",
        "message": {
          "role": "user",
          "content": "{{prompt}}",
          "timestamp": "{{now}}"
        }
      }
    },
    {
      "event": {
        "type": "message_start",
        "message": {
          "role": "assistant",
          "content": []
        }
      }
    },
    {
      "event": {
        "type": "message_update",
        "assistantMessageEvent": {
          "type": "text_start",
          "contentIndex": 0
        }
      }
    },
    {
      "event": {
        "type": "message_update",
        "assistantMessageEvent": {
          "type": "text_delta",
          "contentIndex": 0,
          "delta": "I was checking the project structure when the run was stopped."
        }
      }
    },
    {
      "event": {
        "type": "message_end",
        "message": {
          "role": "assistant",
          "content": [
            {
              "type": "text",
              "text": "I was checking the project structure when the run was stopped."
            }
          ],
          "stopReason": "aborted"
        }
      }
    },
    {
      "delayMs": 5,
      "event": {
        "type": "turn_end",
        "message": {
          "role": "assistant",
          "content": [
            {
              "type": "text",
              "text": ""
            }
          ]
        },
        "toolResults": []
      }
    },
    {
      "delayMs": 5,
      "event": {
        "type": "agent_end",
        "messages": [
          {
            "role": "assistant",
            "content": [
              {
                "type": "text",
                "text": ""
              }
            ]
          }
        ],
        "willRetry": false
      }
    },
    {
      "delayMs": 5,
      "event": {
        "type": "agent_settled"
      }
    }
  ]
}