{
  "name": "ui-input",
  "description": "Extension input dialog with a placeholder and prefilled value.",
  "events": [
    {
      "delayMs": 5,
      "event": {
        "type": "agent_start"
      }
    },
    {
      "delayMs": 5,
      "event": {
        "type": "turn_start"
      }
    },
    {
      "event": {
        "type": "message_start",
        "message": {
          "role": "user",
          "content": "{{prompt}}",
          "timestamp": "{{now}}"
        }
      }
    },
    {
      "event": {
        "type": "message_end",
        "message": {
          "role": "user",
          "content": "{{prompt}}",
          "timestamp": "{{now}}"
        }
      }
    },
    {
      "event": {
        "type": "extension_ui_request",
        "id": "req_input",
        "method": "input",
        "title": "Project label",
        "message": "Choose a short label for this workspace.",
        "placeholder": "for example, mobile-app",
        "prefill": "offline-demo"
      }
    },
    {
      "delayMs": 5,
      "event": {
        "type": "turn_end",
        "message": {
          "role": "assistant",
          "content": [
            {
              "type": "text",
              "text": "The project label is ready."
            }
          ]
        },
        "toolResults": []
      }
    },
    {
      "delayMs": 5,
      "event": {
        "type": "agent_end",
        "messages": [
          {
            "role": "assistant",
            "content": [
              {
                "type": "text",
                "text": "The project label is ready."
              }
            ]
          }
        ],
        "willRetry": false
      }
    },
    {
      "delayMs": 5,
      "event": {
        "type": "agent_settled"
      }
    }
  ]
}