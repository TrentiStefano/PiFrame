{
  "name": "tool-call",
  "events": [
    {
      "delayMs": 10,
      "event": {
        "type": "agent_start"
      }
    },
    {
      "delayMs": 10,
      "event": {
        "type": "turn_start"
      }
    },
    {
      "delayMs": 10,
      "event": {
        "type": "message_start",
        "message": {
          "role": "assistant",
          "content": []
        }
      }
    },
    {
      "delayMs": 10,
      "event": {
        "type": "message_update",
        "usage": {
          "input": 200,
          "output": 10,
          "total": 210
        },
        "assistantMessageEvent": {
          "type": "toolcall_start",
          "contentIndex": 0,
          "id": "call_1",
          "toolName": "read"
        }
      }
    },
    {
      "delayMs": 10,
      "event": {
        "type": "message_update",
        "usage": {
          "input": 200,
          "output": 20,
          "total": 220
        },
        "assistantMessageEvent": {
          "type": "toolcall_delta",
          "contentIndex": 0,
          "delta": "{\"path\":\"file.txt\"}"
        }
      }
    },
    {
      "delayMs": 10,
      "event": {
        "type": "message_update",
        "usage": {
          "input": 200,
          "output": 30,
          "total": 230
        },
        "assistantMessageEvent": {
          "type": "toolcall_end",
          "contentIndex": 0,
          "toolCall": {
            "id": "call_1",
            "name": "read",
            "args": {
              "path": "file.txt"
            }
          }
        }
      }
    },
    {
      "delayMs": 10,
      "event": {
        "type": "message_end",
        "message": {
          "role": "assistant",
          "content": [
            {
              "type": "tool_call",
              "id": "call_1",
              "name": "read",
              "args": {
                "path": "file.txt"
              }
            }
          ]
        }
      }
    },
    {
      "delayMs": 10,
      "event": {
        "type": "tool_execution_start",
        "toolCallId": "call_1",
        "toolName": "read",
        "args": {
          "path": "file.txt"
        }
      }
    },
    {
      "delayMs": 10,
      "event": {
        "type": "tool_execution_update",
        "toolCallId": "call_1",
        "toolName": "read",
        "args": {
          "path": "file.txt"
        },
        "partialResult": "File content preview..."
      }
    },
    {
      "delayMs": 10,
      "event": {
        "type": "tool_execution_end",
        "toolCallId": "call_1",
        "toolName": "read",
        "result": "File content complete.",
        "isError": false
      }
    },
    {
      "delayMs": 10,
      "event": {
        "type": "turn_end",
        "message": {
          "role": "assistant",
          "content": []
        },
        "toolResults": [
          {
            "role": "toolResult",
            "toolCallId": "call_1",
            "result": "File content complete."
          }
        ]
      }
    },
    {
      "delayMs": 10,
      "event": {
        "type": "agent_end",
        "messages": [],
        "willRetry": false
      }
    },
    {
      "delayMs": 10,
      "event": {
        "type": "agent_settled"
      }
    }
  ]
}