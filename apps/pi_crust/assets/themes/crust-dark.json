    "scale": {"xs": 11, "sm": 12, "md": 14, "lg": 16, "xl": 20, "xxl": 28},
    "lineHeight": 1.55, "weights": {"regular": 400, "medium": 500, "semibold": 600}
  },
  "spacing": {"unit": 4, "scale": [0, 4, 8, 12, 16, 24, 32, 48]},
  "radii": {"sm": 2, "md": 2, "lg": 4, "pill": 999},
  "elevation": {"level1": {"color": "#00000026", "blur": 16, "offsetY": 4}, "level2": {"color": "#00000040", "blur": 32, "offsetY": 12}},
  "motion": {"fast": 120, "normal": 240, "slow": 240, "curve": "decisiveOut", "drawerCurve": "drawer"},
