{
  "$schema": "./theme.schema.json",
  "schemaVersion": 1,
  "id": "crust-dark",
  "name": "Catppuccin Frappé",
  "author": "Pi-Crust · Catppuccin",
  "version": "4.0.0",
  "variant": "dark",
  "extends": null,
  "colors": {
    "background": "#303446",
    "chassis": "#292c3c",
    "displaySurface": "#414559",
    "displayText": "#c6d0f5",
    "signalWarning": "#e5c890",
    "signalDanger": "#e78284",
    "surface": "#303446",
    "surfaceElevated": "#414559",
    "overlay": "#232634b3",
    "border": "#51576d",
    "borderStrong": "#737994",
    "textPrimary": "#c6d0f5",
    "textSecondary": "#b5bfe2",
    "textMuted": "#b5bfe2",
    "accent": "#ca9ee6",
    "accentContrast": "#303446",
    "focusRing": "#ca9ee6",
    "success": "#a6d189",
    "warning": "#e5c890",
    "danger": "#e78284",
    "info": "#8caaee",
    "agentWorking": "#a6d189",
    "agentRetrying": "#e5c890",
    "agentCompacting": "#8caaee",
    "agentSettled": "#a6d189",
    "agentAwaitingUser": "#e5c890",
    "agentError": "#e78284",
    "userBubble": "#414559",
    "thinking": "#babbf1",
    "diffAddedBg": "#a6d18926",
    "diffAddedFg": "#a6d189",
    "diffRemovedBg": "#e7828426",
    "diffRemovedFg": "#e78284",
    "diffContextFg": "#a5adce"
  },
  "syntax": {
    "keyword": "#ca9ee6",
    "string": "#a6d189",
    "number": "#ef9f76",
    "comment": "#a5adce",
    "function": "#8caaee",
    "type": "#e5c890",
    "variable": "#c6d0f5",
    "operator": "#b5bfe2",
    "punctuation": "#b5bfe2",
    "invalid": "#e78284"
  },
  "typography": {
    "uiFontFamily": "SchibstedGrotesk",
    "headingFontFamily": "BarlowCondensed",
    "monoFontFamily": "SourceCodePro",
    "baseSize": 14,
    "scale": {"xs": 11, "sm": 12, "md": 14, "lg": 16, "xl": 20, "xxl": 28},
    "lineHeight": 1.55,
    "weights": {"regular": 400, "medium": 500, "semibold": 600}
  },
  "spacing": {"unit": 4, "scale": [0, 4, 8, 12, 16, 24, 32, 48]},
  "radii": {"sm": 6, "md": 10, "lg": 14, "pill": 999},
  "elevation": {"level1": {"color": "#23263440", "blur": 16, "offsetY": 4}, "level2": {"color": "#23263466", "blur": 32, "offsetY": 12}},
  "motion": {"fast": 120, "normal": 240, "slow": 240, "curve": "decisiveOut", "drawerCurve": "drawer"},
  "components": {
    "sidebar": {"background": "#292c3c", "width": 280},
    "composer": {"background": "#414559", "minHeight": 112},
    "toolCard": {"background": "#414559", "borderRadius": 10}
  }
}
