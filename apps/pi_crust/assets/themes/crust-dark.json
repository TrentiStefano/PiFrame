{
  "$schema": "./theme.schema.json",
  "schemaVersion": 1,
  "id": "crust-dark",
  "name": "Crust Dark · Precision",
  "author": "Pi-Crust",
  "version": "2.0.0",
  "variant": "dark",
  "extends": null,
  "colors": {
    "background": "#151916", "chassis": "#262D27", "displaySurface": "#080C09", "displayText": "#F0F2E9", "signalWarning": "#F1B73A", "signalDanger": "#E6423A", "surface": "#202621", "surfaceElevated": "#303931",
    "overlay": "#1C211EB3", "border": "#424D43", "borderStrong": "#657568",
    "textPrimary": "#F0F2E9", "textSecondary": "#CAD0C5", "textMuted": "#A7B2A3",
    "accent": "#83CCA1", "accentContrast": "#173024", "focusRing": "#83CCA1",
    "success": "#83CCA1", "warning": "#F1B73A", "danger": "#FF9A91", "info": "#B7C8D0",
    "agentWorking": "#83CCA1", "agentRetrying": "#F1B73A", "agentCompacting": "#B7C8D0",
    "agentSettled": "#83CCA1", "agentAwaitingUser": "#F1B73A", "agentError": "#FF9A91",
    "userBubble": "#303D32", "thinking": "#CFBBA6",
    "diffAddedBg": "#223D2C", "diffAddedFg": "#9BD8B2",
    "diffRemovedBg": "#462E29", "diffRemovedFg": "#FFB2AA", "diffContextFg": "#A7B2A3"
  },
  "syntax": {
    "keyword": "#FFB2AA", "string": "#9BD8B2", "number": "#F1C778", "comment": "#A7B2A3",
