{
  "$schema": "./theme.schema.json",
  "schemaVersion": 1,
  "id": "crust-light",
  "name": "Catppuccin Latte",
  "author": "Pi-Crust · Catppuccin",
  "version": "4.0.0",
  "variant": "light",
  "extends": null,
  "colors": {
    "background": "#eff1f5",
    "chassis": "#e6e9ef",
    "displaySurface": "#ccd0da",
    "displayText": "#4c4f69",
    "signalWarning": "#df8e1d",
    "signalDanger": "#d20f39",
    "surface": "#eff1f5",
    "surfaceElevated": "#e6e9ef",
    "overlay": "#dce0e8b3",
    "border": "#bcc0cc",
    "borderStrong": "#8c8fa1",
    "textPrimary": "#4c4f69",
    "textSecondary": "#5c5f77",
    "textMuted": "#5c5f77",
    "accent": "#8839ef",
    "accentContrast": "#eff1f5",
    "focusRing": "#8839ef",
    "success": "#40a02b",
    "warning": "#df8e1d",
    "danger": "#d20f39",
    "info": "#1e66f5",
    "agentWorking": "#40a02b",
    "agentRetrying": "#df8e1d",
    "agentCompacting": "#1e66f5",
    "agentSettled": "#40a02b",
    "agentAwaitingUser": "#df8e1d",
    "agentError": "#d20f39",
    "userBubble": "#e6e9ef",
    "thinking": "#7287fd",
    "diffAddedBg": "#40a02b26",
    "diffAddedFg": "#216d18",
    "diffRemovedBg": "#d20f3926",
    "diffRemovedFg": "#b0002c",
    "diffContextFg": "#5c5f77"
  },
  "syntax": {
    "keyword": "#8839ef",
    "string": "#4c4f69",
    "number": "#5c5f77",
    "comment": "#5c5f77",
    "function": "#4c4f69",
    "type": "#5c5f77",
    "variable": "#4c4f69",
    "operator": "#5c5f77",
    "punctuation": "#5c5f77",
    "invalid": "#d20f39"
  },
  "typography": {
    "uiFontFamily": "SchibstedGrotesk",
    "headingFontFamily": "BarlowCondensed",
    "monoFontFamily": "SourceCodePro",
    "baseSize": 14,
    "scale": {"xs": 11, "sm": 12, "md": 14, "lg": 16, "xl": 20, "xxl": 28},
    "lineHeight": 1.55,
    "weights": {"regular": 400, "medium": 500, "semibold": 600}
  },
  "spacing": {"unit": 4, "scale": [0, 4, 8, 12, 16, 24, 32, 48]},
  "radii": {"sm": 6, "md": 10, "lg": 14, "pill": 999},
  "elevation": {"level1": {"color": "#4c4f6914", "blur": 16, "offsetY": 4}, "level2": {"color": "#4c4f6929", "blur": 32, "offsetY": 12}},
  "motion": {"fast": 120, "normal": 240, "slow": 240, "curve": "decisiveOut", "drawerCurve": "drawer"},
  "components": {
    "sidebar": {"background": "#e6e9ef", "width": 280},
    "composer": {"background": "#e6e9ef", "minHeight": 112},
    "toolCard": {"background": "#e6e9ef", "borderRadius": 10}
  }
}
