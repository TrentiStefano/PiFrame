{
  "name": "@piframe/agentd",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "PiFrame persistent daemon runtime",
  "piCompat": "^0.85.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && pnpm build:bundle",
    "build:bundle": "esbuild src/main.ts --bundle --platform=node --target=node22 --outfile=dist/pi-agentd.cjs --sourcemap",
    "build:sea": "pnpm build:bundle && node --experimental-sea-config sea-config.json",
    "dev": "node --watch dist/main.js",
    "lint": "tsc --noEmit",
    "test": "node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@piframe/pcp-ts": "workspace:*",
    "chokidar": "^4.0.3",
    "ulid": "^2.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.14",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
